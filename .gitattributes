# Git converts line endings based on core.autocrlf, which would rewrite these files with
# Windows CRLF. That breaks the shell scripts on Linux ("/usr/bin/env bash^M: bad interpreter")
# and the nginx/compose files, which are read by tools that expect LF. Pin LF for everything.

* text=auto eol=lf

*.sh      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.conf    text eol=lf
*.md      text eol=lf
*.example text eol=lf
*.gitignore     text eol=lf
*.gitattributes text eol=lf

# Secrets and keys are binary: never touch their line endings
*.pem   binary
*.key   binary
*.p12   binary
*.pfx   binary
*.jks   binary
