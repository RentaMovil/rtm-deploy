# Copiar a .env (nunca comitear .env). Lo usa docker-compose.yml.

# Token de tu cuenta de ngrok (gratis): https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=ChangeMe_ngrok_authtoken

# Dominio fijo reservado en https://dashboard.ngrok.com/domains ("+ New Domain").
# Sin esto la URL pública cambia cada vez que se reinicia el contenedor "ngrok".
NGROK_DOMAIN=tu-dominio.ngrok-free.app
